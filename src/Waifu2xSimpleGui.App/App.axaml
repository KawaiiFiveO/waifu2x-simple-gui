<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Waifu2xSimpleGui.App.App"
             RequestedThemeVariant="Dark">
             <!-- Dark by default; the "Light theme" toggle switches at runtime (MainViewModel.ApplyTheme). -->

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Fixed accent: the OS accent can be grey (unreadable white-on-grey buttons) or absent on Linux. -->
                <ColorPaletteResources x:Key="Light" Accent="#2F48C8" />
                <!-- Dark mode: grey surfaces instead of Fluent's near-black. -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#3F5FE0"
                                       RegionColor="#2B2B2B"
                                       AltHigh="#2B2B2B"
                                       AltMediumHigh="#333333"
                                       ChromeLow="#3A3A3A"
                                       ChromeMediumLow="#3C3C3C"
                                       ChromeMedium="#444444" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- Always-visible full-width scrollbars (Fluent collapses them and expands on hover after a delay).
             ListBox/ComboBox/TextBox template-bind their inner ScrollViewer to their own attached value. -->
        <Style Selector="ScrollViewer, :is(ItemsControl), TextBox">
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
    </Application.Styles>
</Application>
